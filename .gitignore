# FILE: shreetech-crm/.gitignore

# Node.js dependencies — like compiled .o files, regenerated by running npm install
node_modules/

# Environment variable files — contain passwords and API keys, never commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output — generated files, like .exe or a.out in C
dist/
build/

# OS-generated files — created by Windows/Mac/Linux file explorers, not part of your code
.DS_Store
Thumbs.db

# VS Code editor settings — personal preferences, not needed by others
.vscode/settings.json

# Prisma generated client — regenerated by running npx prisma generate
node_modules/.prisma/

# Log files — auto-generated, not source code
*.log
npm-debug.log*